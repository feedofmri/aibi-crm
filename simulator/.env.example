# Copy to simulator/.env.local to override (never commit secrets).

# CRM API base URL. Leave empty in development (Vite proxies /api to :4000).
# In production, e.g. https://crm.example.com
VITE_API_URL=

# Must match CHANNEL_KEY on the CRM server. The development default is shown.
# Note: anything prefixed VITE_ is visible in the browser, so treat this key as
# a demo credential and rotate it if the simulator is public.
VITE_CHANNEL_KEY=dev-channel-key
