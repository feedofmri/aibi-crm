# Copy to .env to enable live AI. Never commit your key.
# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Or Meta Model API
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Or OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3000
# Default binds only to your own computer. Read docs/DEPLOYMENT.md before hosting.
HOST=127.0.0.1
