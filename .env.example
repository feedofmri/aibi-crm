# Copy to .env (never commit it). Read by the server.

# --- Server ---
NODE_ENV=development
PORT=4000
# Bind to 0.0.0.0 only when hosting; see docs/DEPLOYMENT.md
HOST=127.0.0.1
# Required in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# --- Database ---
# Matches docker-compose.yml. Change for your own PostgreSQL.
DATABASE_URL=postgresql://biai:biai_dev_password@127.0.0.1:5432/biai_crm

# --- Live AI (optional; configure one) ---
# If several are set, Gemini is used first, then Meta, then OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
